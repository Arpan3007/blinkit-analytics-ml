# InsightForge Analytics - Backend Environment Variables
# Copy this file to .env and fill in your credentials.
# The .env file is listed in .gitignore and will NOT be committed.

# ─── Kaggle ─────────────────────────────────────────────────────────────────
# Get your Kaggle credentials at: https://www.kaggle.com/settings → API → Create Token
# This downloads a kaggle.json; copy the values here.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ─── Gemini (optional) ───────────────────────────────────────────────────────
# Used for deep ML insights. Leave blank to use the built-in rule engine.
GEMINI_API_KEY=
